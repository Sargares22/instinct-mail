# Gmail credentials (required). Use a Google App Password, not your account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# The exact email address of the Instinct agent you intend to contact.
INSTINCT_ADDRESS=

# Optional: seconds between mailbox checks.
# POLL_SECONDS=60
# Optional: override the default INBOX + Gmail \\All folder search.
# IMAP_FOLDERS=INBOX

# Optional: notifiers for the `serve` receiver. A JSON array of arguments, run without a shell.
# {thread} is the thread given to `ask --thread`, {text} is a fixed wake-up message.
# NOTIFY_BB=["bb", "thread", "tell", "{thread}", "{text}"]
