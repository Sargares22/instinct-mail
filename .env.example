# Gmail credentials (required). Use a Google App Password, not your account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# The exact email address of the Instinct agent you intend to contact.
INSTINCT_ADDRESS=

# Optional: polling interval in seconds.
# POLL_SECONDS=60
# Optional: override the default INBOX + Gmail \\All folder search.
# IMAP_FOLDERS=INBOX
